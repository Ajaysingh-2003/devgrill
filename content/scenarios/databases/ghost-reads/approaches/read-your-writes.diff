@@ -113,3 +113,23 @@
         log.warning("cache unavailable", extra=fields(error=type(exc).__name__))
         return None
     return None if raw is None else int(raw)
+
+
+#: How long a shopper's reads stay on the primary after they write: longer than the replica
+#: can fall behind.
+FRESH_S = 120
+
+
+def mark_wrote(user_id: int) -> None:
+    try:
+        client.set(f"wrote:{user_id}", 1, ex=FRESH_S)
+    except redis.RedisError as exc:
+        log.warning("cache write failed", extra=fields(error=type(exc).__name__))
+
+
+def wrote_recently(user_id: int) -> bool:
+    """Whether this shopper wrote lately (or we can't tell): then read from the primary."""
+    try:
+        return bool(client.exists(f"wrote:{user_id}"))
+    except redis.RedisError:
+        return True
