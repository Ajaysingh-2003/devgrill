+def provider_backoff() -> float:
+    """Exponential and capped, with jitter: after a blip, eight consumers don't come back at
+    the same moment, and a provider that is refusing calls gets fewer of them, not more."""
+    failures = getattr(_failures, "count", 0) + 1
+    _failures.count = failures
+    return random.uniform(0.5, 1.0) * min(10.0, 0.25 * 2**failures)
 
 
