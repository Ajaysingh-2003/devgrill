+def _build_once() -> dict[str, Any]:
+    """No copy at all (a first deploy, or an emptied cache): one request builds the page and
+    everyone else waits for its copy. A build per shopper would all run at once, and on a busy
+    database none of them would finish within DEALS_TIMEOUT_MS."""
+    if cache.claim_deals_refresh():
+        try:
+            return _build_deals()
+        finally:
+            cache.release_deals_refresh()
+    deadline = time.monotonic() + 3.0
+    while time.monotonic() < deadline:
+        time.sleep(0.05)
+        page = cache.get_deals()
+        if page is not None:
+            return page
+    raise HTTPException(503, "the deals page is being rebuilt, try again")
 
 
