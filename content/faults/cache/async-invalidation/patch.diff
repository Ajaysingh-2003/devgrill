+def invalidate_later(product_id: int) -> None:
+    """Queue the delete for the invalidation worker, off the request path."""
+    try:
+        client.lpush("cache:invalidations", product_id)
+    except redis.RedisError as exc:
+        log.warning("cache invalidate failed", extra=fields(error=type(exc).__name__))
+
+
 def healthy() -> bool:
     try:
         return bool(client.ping())
