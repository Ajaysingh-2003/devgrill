+
+
+def search_key(q: str, limit: int) -> str:
+    return f"search:{limit}:{q.strip().lower()}"
+
+
+def get_search(q: str, limit: int) -> list[dict[str, Any]] | None:
+    try:
+        raw = client.get(search_key(q, limit))
+    except redis.RedisError as exc:
+        log.warning("cache unavailable", extra=fields(error=type(exc).__name__))
+        return None
+    return None if raw is None else json.loads(raw)
+
+
+def set_search(q: str, limit: int, results: list[dict[str, Any]]) -> None:
+    """Search results change only when the catalogue does, so they are kept."""
+    try:
+        client.set(search_key(q, limit), json.dumps(results, default=str))
+    except redis.RedisError as exc:
+        log.warning("cache write failed", extra=fields(error=type(exc).__name__))
