# orders worker runtime config. Ships with every deploy (`devgrill deploy worker`).

# Attempts before a failing order is parked in the dead-letter list (orders:dead).
# 0 retries forever.
MAX_ATTEMPTS=3
# Seconds the worker waits for a new order before checking again.
POLL_S=1
# Seconds a failed order waits before it is tried again (it keeps its place at the head).
RETRY_BACKOFF_S=0.2
# Seconds to wait for the payment provider to answer a charge.
PAYMENT_TIMEOUT_S=10
# Orders charged at once. One consumer charges them strictly in the order they were placed.
CONSUMERS=1
