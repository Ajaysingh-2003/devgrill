# product-api runtime config. Ships with every deploy (`devgrill deploy`).

# Primary database, in this region.
DATABASE_URL=postgresql://shopkart:shopkart@postgres:5432/shopkart
# Postgres connections per API process (4 processes share the database's 100 slots).
DB_POOL_MIN=2
DB_POOL_MAX=10
# Seconds a request waits for a free connection before failing with 503.
DB_POOL_TIMEOUT_S=5

# Product cache lifetime in seconds. 0 disables caching.
CACHE_TTL_SECONDS=300
CACHE_KEY_PREFIX=

# Longest a query waits for a row or table lock, in milliseconds. 0 waits forever.
DB_LOCK_TIMEOUT_MS=0
# Longest a single query may run, in milliseconds. 0 means no limit.
DB_STATEMENT_TIMEOUT_MS=0
