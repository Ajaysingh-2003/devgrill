# ledger-api runtime config. Ships with every deploy (`devgrill deploy`).

DATABASE_URL=postgresql://ledger:ledger@postgres-db:5432/ledger
# Postgres connections per API process (4 processes share the database's 100 slots).
DB_POOL_MIN=2
DB_POOL_MAX=10
# Seconds a request waits for a free connection before failing with 503.
DB_POOL_TIMEOUT_S=5
