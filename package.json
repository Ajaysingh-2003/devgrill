{
  "name": "devgrill",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @devgrill/web dev",
    "gen:api": "uv run python -m devgrill_api.openapi_export && pnpm --filter @devgrill/api-client gen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "colors:check": "node scripts/check-raw-colors.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "storybook": "pnpm --filter @devgrill/ui storybook",
    "e2e": "pnpm --filter @devgrill/web e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
