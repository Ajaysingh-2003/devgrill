# Copy to .env (just setup does this). Never commit .env.
# Values below match infra/compose/docker-compose.dev.yml.

# ---- shared
DEVGRILL_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console
DATABASE_URL=postgresql+asyncpg://devgrill:devgrill@localhost:5432/devgrill
VALKEY_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=devgrill-default

# ---- api / gateway / web
API_HOST=127.0.0.1
API_PORT=8000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:8100

# ---- object storage (SeaweedFS, S3 API)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=devgrill
S3_SECRET_KEY=devgrill-dev-secret
S3_BUCKET=devgrill-dev

# ---- email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- auth (Better Auth in the web app + GitHub OAuth App; see docs/runbooks/github-oauth.md)
# Secrets left empty are generated by `just setup` (scripts/setup.py).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub endpoints; tests point these at the mock IdP (apps/web/e2e/mock-github.mjs).
GITHUB_OAUTH_URL=https://github.com
GITHUB_API_URL=https://api.github.com
# The API verifies Better Auth JWTs (EdDSA) against this JWKS, issuer and audience.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=devgrill-api
# Web server -> API calls (server components); browsers use NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:8000
# Signs the sign-in hook (POST /internal/profiles) and guest tokens.
INTERNAL_HMAC_SECRET=
GUEST_TOKEN_SECRET=
# Comma-separated GitHub logins that get the admin role (applied at sign-in).
ADMIN_GITHUB_LOGINS=
# Seconds a signed session is trusted from its cookie before re-checking the database.
AUTH_COOKIE_CACHE_SECONDS=300

# ---- ai (phase 6; owner provides the key)
OPENAI_API_KEY=
LLM_DAILY_BUDGET_USD=5

# ---- observability (off by default)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ---- sandbox (phase 3; ADR 012, ADR 013). Session length and idle time come from the plan.
SANDBOX_DRIVER=compose
CONTENT_ROOT=content
# Fleet cap: sandboxes alive at once on this machine.
SANDBOX_MAX_LIVE=4
# Money cap: sandbox-minutes free and guest users may use per IST day; 80% alerts, 100% pauses.
SANDBOX_DAILY_MINUTES_BUDGET=600
# Kill switch for free and guest starts.
SANDBOX_FREE_STARTS=true
# Scenarios guests may play on /try.
SANDBOX_GUEST_SCENARIOS=ttl-zero

# ---- Windows + corporate proxy (see docs/PLAN.md §5.5)
# NODE_OPTIONS=--use-system-ca        (already set as a user env var on this machine)
UV_SYSTEM_CERTS=1
