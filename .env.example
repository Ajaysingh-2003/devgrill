# Copy to .env (just setup does this). Never commit .env.
# Values below match infra/compose/docker-compose.dev.yml.

# ---- shared
DEVGRILL_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console
DATABASE_URL=postgresql+asyncpg://devgrill:devgrill@localhost:5432/devgrill
VALKEY_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=devgrill-default

# ---- api / gateway / web
API_HOST=127.0.0.1
API_PORT=8000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:8100

# ---- object storage (SeaweedFS, S3 API)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=devgrill
S3_SECRET_KEY=devgrill-dev-secret
S3_BUCKET=devgrill-dev

# ---- email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- auth (phase 2: Better Auth + GitHub OAuth App)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
INTERNAL_HMAC_SECRET=

# ---- ai (phase 6; owner provides the key)
OPENAI_API_KEY=
LLM_DAILY_BUDGET_USD=5

# ---- observability (off by default)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ---- sandbox (phase 3)
SANDBOX_DRIVER=compose
SANDBOX_TTL_MINUTES=45
SANDBOX_IDLE_MINUTES=10

# ---- Windows + corporate proxy (see docs/PLAN.md §5.5)
# NODE_OPTIONS=--use-system-ca        (already set as a user env var on this machine)
UV_SYSTEM_CERTS=1
